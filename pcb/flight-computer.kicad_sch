				(size 1.27 1.27)
			)
		)
		(uuid "5d2a69bf-5f86-4044-8609-9a836ef30c67")
	)
	(text "GPS uses UART4\n\ncould be swapped for\nease of routing if needed"
		(exclude_from_sim no)
		(at 168.656 82.55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "82ec9b15-27a1-48bb-a37a-3aab1520638a")
	)
	(text "VBUS_DETECT\nnecessary b/c\nexternally powered"
		(exclude_from_sim no)
		(at 24.384 45.212 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a9d599f6-c4e9-40d0-8fd8-b5751a2fddad")
	)
	(text "All sensors share single\nhalf duplex SPI bus\n\ncould upgrade to full\nduplex but idk if it\nwould be useful when\nonly reading registers"
		(exclude_from_sim no)
		(at 167.894 56.896 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "db2a701a-a91b-4316-9e2b-e20dae76e202")
	)
	(text "Flash and SD card can\nshare a SPI because\ndata only written to \nflash in-flight\n\nData copied to SD card\nupon landing"
		(exclude_from_sim no)
		(at 168.656 117.094 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "eeff062d-fcc4-4ba8-ac2d-eefc3316f69e")
	)
	(text "Telemetry is high priority\nalthough low time on bus\nbut it can have its own SPI"
		(exclude_from_sim no)
		(at 170.18 151.384 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f976bb3b-99e6-4b0f-852e-c6fc4cb73d9b")
	)
	(text "PYROn_CONT must\nbe connected to\n5V tolerant GPIO"
