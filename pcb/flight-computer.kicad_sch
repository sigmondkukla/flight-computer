	(lib_symbols)
	(text "LEDs and buzzer\nshare PWM timer"
		(exclude_from_sim no)
		(at 37.592 110.49 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0b1800b3-99d4-4620-a5c7-aa9ce4781908")
	)
	(text "each pyro channel has\nan active high MOSFET gate input,\nan active high continuity output,\nand a status LED\n\nthere's also a gate LED for testing\nalthough I may want to improve on\nthat"
		(exclude_from_sim no)
		(at 168.402 91.948 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "127501f0-de7d-4040-b161-9308965c67a7")
	)
	(text "save GPIO"
		(exclude_from_sim no)
		(at 133.35 56.134 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "423409e4-23b6-4fcf-a597-cf37624e8bcd")
	)
	(text "camera controlled by UART\nload switch to turn on last minute"
		(exclude_from_sim no)
		(at 32.258 92.202 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "53a66b81-d6a3-4aeb-8e7d-fb1d9adf6a32")
	)
	(text "todo: TP?"
		(exclude_from_sim no)
		(at 133.858 33.274 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5497299a-1e66-4dc9-8dac-bfbc2feea3b0")
	)
	(text "two buttons\nand cheap OLED\nfor field usage"
		(exclude_from_sim no)
		(at 29.21 122.936 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "74fbd554-4183-4aae-8eeb-03cfc84e6eb9")
	)
	(text "TIM5 and TIM2 CH1-4\nboth available here"
		(exclude_from_sim no)
		(at 37.846 146.304 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "91c3c833-e10c-4625-999b-9e9a28531073")
	)
	(text "All sensors share single\nhalf duplex SPI bus\n\ncould upgrade to full\nduplex but idk if it\nwould be useful when\nonly reading registers"
		(exclude_from_sim no)
		(at 180.594 44.196 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "db2a701a-a91b-4316-9e2b-e20dae76e202")
	)
	(text "Flash and SD card can\nshare a SPI because\ndata only written to \nflash in-flight\n\nData copied to SD card\nupon landing\n\nWith H5 MCU in 100 pin\npackage we can give each\na 4 bit bus"
		(exclude_from_sim no)
		(at 180.34 153.924 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "eeff062d-fcc4-4ba8-ac2d-eefc3316f69e")
	)
	(text "Telemetry is high priority\nalthough low time on bus\nbut it can have its own SPI"
		(exclude_from_sim no)
		(at 182.626 128.778 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
